{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bgen config.yaml",
  "type": "object",
  "default": {},
  "additionalProperties": false,
  "required": ["metadata"],
  "properties": {
    "output-dir":       { "type": "string",   "default": "output" },
    "output-file-base": { "type": "string",   "default": "book" },
    "typography-file":  { "type": "string",   "default": "" },
    "trace":            { "type": "boolean",  "default": false },
    "verbose":          { "type": "boolean",  "default": false },
    "keep-metadata":    { "type": "boolean",  "default": false },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "required": ["title", "author"],
      "properties": {
        "title":        { "type": "string", "minLength": 1 },
        "lang":         { "type": "string", "default": "ru" },
        "cover-image":  { "type": "string", "default": "" },
        "author": {
          "type": "array",
          "minItems": 1,
          "items":      { "type": "string", "minLength": 1 }
        }
      }
    },
    "fb2": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":          { "type": "boolean",  "default": false      },
        "print-mode":       { "type": "string",   "default": "pretty",    "enum": ["pretty", "toleft", "src"]       },
        "zip":              { "type": "boolean",  "default": false      },
        "description-mode": { "type": "string",   "default": "auto",      "enum": ["auto", "template", "override"]  },
        "description-file": { "type": "string",   "default": ""         },
        "genres":           { "type": "array",    "default": [],
          "items":
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 100,
                "description": "0 означает, что поле не выставлено и писать в xml его не нужно"
              }
            }
          }
        },
        "title-author": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "anyOf": [
              { "required": ["nickname"] },
              { "required": ["first-name", "last-name"] }
            ],
            "additionalProperties": false,
            "properties": {
              "first-name":   { "type": "string", "minLength": 1 },
              "middle-name":  { "type": "string", "minLength": 1 },
              "last-name":    { "type": "string", "minLength": 1 },
              "nickname":     { "type": "string", "minLength": 1 },
              "home-page": {
                "type": "array", "items": { "type": "string", "minLength": 1 },
                  "default": []
              },
              "email": {
                "type": "array", "items": { "type": "string", "minLength": 1 },
                  "default": []
              },
              "id":           { "type": "string", "minLength": 1 }
            }
          }
        },
        "book-title-lang":    { "type": "string", "default": "" },
        "annotation-lang":    { "type": "string", "default": "" },
        "keywords": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title-date":         {"$ref": "#/$defs/dateType", "default": {} },
        "doc-date":           {"$ref": "#/$defs/dateType", "default": {} },
        "sequence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": ["integer", "string"],
                "default": 0
              },
              "lang": {
                "type": "string",
                "default": ""
              }
            }
          }
        },
        "doc-author-copy-first-from-title": {"type": "boolean", "default": false},
        "id":                               {"type": "string",  "default": ""},
        "version":                          {"type": "string",  "default": ""}
      },
      "if": {
        "properties": { "description-mode": { "enum": ["template", "override"] } },
        "required": ["description-mode"]
      },
      "then": {
        "required": ["description-file"],
        "properties": { "description-file": { "minLength": 1 } }
      }
    },
    "epub": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":            { "type": "boolean",                                  "default": false },
        "css-file":           { "type": "string",                                   "default": "" },
        "toc":                { "type": "boolean",                                  "default": false },
        "add-meta-mode":      { "type": "string", "enum": ["none", "yaml", "xml"],  "default": "none" },
        "add-meta-xml-file":  { "type": "string",                                   "default": "" },
        "add-meta-yaml":      { "type": "object", "additionalProperties": true,     "default": {} }
      },
      "allOf": [
        {
          "if": {
            "properties": { "add-meta-mode": { "enum": ["yaml"] } },
            "required": ["add-meta-mode"]
          },
          "then": {
            "properties": { "add-meta-yaml": { "minProperties": 1 } },
            "required": ["add-meta-yaml"]
          }
        },
        {
          "if": {
            "properties": { "add-meta-mode": { "enum": ["xml"] } },
            "required": ["add-meta-mode"]
          },
          "then": {
            "properties": { "add-meta-xml-file": { "minLength": 1 } },
            "required": ["add-meta-xml-file"]
          }
        }
      ]
    },
    "docx": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean",                                      "default": false },
        "reference-file": { "type": "string",                                       "default": "" },
        "toc":            { "type": "boolean",                                      "default": false }
      }
    },
    "txt": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean",                                      "default": false },
        "columns":        { "type": "integer", "minimum": 1,                        "default": 80 },
        "wrap-mode":      { "type": "string", "enum": ["auto", "none", "preserve"], "default": "auto" },
        "card":           { "type": "boolean",                                      "default": false }
      }
    }
  },
  "$defs": {
    "dateType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Атрибут value в FB2: xs:date, формат YYYY-MM-DD"
        },
        "text": {
          "type": "string",
          "default": "",
          "description": "Содержимое <date>: человекочитаемая дата, напр. '1863-1867'"
        },
        "lang": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}
