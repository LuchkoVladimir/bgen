{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bgen config.yaml",
  "type": "object",
  "default": {},
  "additionalProperties": false,
  "required": ["metadata"],
  "properties": {
    "output-dir":     { "type": "string", "default": "output" },
    "output-file-base":{"type": "string", "default": "book" },
    "typography":     { "type": "string", "default": "" },
    "trace":          { "type": "boolean", "default": false },
    "verbose":        { "type": "boolean", "default": false },
    "keep-metadata":  { "type": "boolean", "default": false },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true,
      "required": ["title", "author"],
      "properties": {
        "title":        { "type": "string", "minLength": 1 },
        "lang":         { "type": "string", "default": "ru" },
        "cover-image":  { "type": "string", "default": "" },
        "author": {
          "oneOf": [    { "type": "string", "minLength": 1 },
              { "type": "array",  "minItems": 1,
               "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "fb2": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":          { "type": "boolean",  "defualt": false      },
        "print":            { "type": "string",   "defualt": "pretty",
          "enum": ["pretty", "toleft", "src"]                           },
        "zip":              { "type": "boolean",  "defualt": false      },
        "description":      { "type": "string",   "defualt": "auto",
          "enum": ["auto", "template", "override"]                      },
        "description-file": { "type": "string",   "defualt": ""         },
        "genres":           { "type": "array",    "defualt": [],
          "items": {
            "oneOf": [      { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "match": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            ]
          }
        },
        "title-author": {
          "type": "array",
          "default": [],
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "first-name": { "type": "string", "minLength": 1 },
                  "middle-name": { "type": "string", "minLength": 1 },
                  "last-name": { "type": "string", "minLength": 1 },
                  "nickname": { "type": "string", "minLength": 1 },
                  "home-page": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "array", "items": { "type": "string", "minLength": 1 } }
                    ]
                  },
                  "email": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "array", "items": { "type": "string", "minLength": 1 } }
                    ]
                  },
                  "id": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title-date": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "sequence": {
          "type": "array",
          "default": [],
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "number": {
                    "type": ["integer", "string"]
                  },
                  "lang": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "doc-author-copy-first-from-title": {"type": "boolean", "default": false},
        "date":                             {"type": "string",  "default": ""},
        "id":                               {"type": "string",  "default": ""},
        "version":                          {"type": "string",  "default": ""}
      },
      "allOf": [
        {
          "if": {
            "properties": { "description": { "enum": ["template", "override"] } },
            "required": ["description"]
          },
          "then": {
            "required": ["description-file"],
            "properties": { "description-file": { "minLength": 1 } }
          }
        },
        {
          "if": {
            "properties": { "description": { "enum": ["auto"] } },
            "required": ["description"]
          },
          "then": {
            "properties": { "description-file": { "maxLength": 0 } }
          }
        },
        {
          "if": {
            "not": { "required": ["description"] }
          },
          "then": {
            "properties": { "description-file": { "maxLength": 0 } }
          }
        }
      ]
    },
    "epub": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean",                                      "default": false },
        "css":            { "type": "string",                                       "default": "" },
        "toc":            { "type": "boolean",                                      "default": false },
        "metadata-file":  { "type": "string",                                       "default": "" },
        "metadata":       { "type": "object", "additionalProperties": true,         "default": {}}
      },
      "allOf": [
        {
          "if": {
            "properties": { "metadata-file": { "minLength": 1 } },
            "required": ["metadata-file"]
          },
          "then": {
            "not": {
              "properties": { "metadata": { "minProperties": 1 } },
              "required": ["metadata"]
            }
          }
        },
        {
          "if": {
            "properties": { "metadata": { "minProperties": 1 } },
            "required": ["metadata"]
          },
          "then": {
            "not": {
              "properties": { "metadata-file": { "minLength": 1 } },
              "required": ["metadata-file"]
            }
          }
        }
      ]
    },
    "docx": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean",                                      "default": false },
        "reference_doc":  { "type": "string",                                       "default": "" },
        "toc":            { "type": "boolean",                                      "default": false }
      }
    },
    "txt": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "enabled":      { "type": "boolean",                                        "default": false },
        "columns":      { "type": "integer", "minimum": 1,                          "default": 80 },
        "wrap":         { "type": "string", "enum": ["auto", "none", "preserve"],   "default": "auto" },
        "card":         { "type": "boolean",                                        "default": false }
      }
    }
  }
}
